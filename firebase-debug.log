[debug] [2026-07-31T18:15:53.752Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-detective-game:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper function: Safely checks if the requesting user's profile has role == 'host'\n    function isHost() {\n      return request.auth != null &&\n        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&\n        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'host';\n    }\n\n    // 1. Users collection\n    match /users/{accountId} {\n      // Allow Host full read and write access to all user documents; allow users to read/write profiles\n      allow read, write: if isHost() || true;\n\n      // CRITICAL: Block all client-side read/write access to private subcollections\n      match /private/{document=**} {\n        allow read, write: if false;\n      }\n\n      // Allow non-private subcollections (e.g. /evidence)\n      match /{subcollection}/{docId} {\n        allow read, write: if subcollection != 'private';\n      }\n    }\n\n    // 2. Global System Game State (/system/gameState)\n    match /system/{document=**} {\n      allow read, write: if isHost() || true;\n    }\n\n    // 3. Secret Worries & Messages Collection\n    match /messages/{document=**} {\n      allow read, write: if isHost() || true;\n    }\n\n    // 4. Manual Approval Queue & Submissions Collection\n    match /submissions/{document=**} {\n      allow read, write: if isHost() || true;\n    }\n\n    // 5. Agency Bulletin Board Collection\n    match /bulletin/{document=**} {\n      allow read, write: if isHost() || true;\n    }\n\n    // 6. Secret Worries D-3 to D-1 Collection\n    match /worries/{document=**} {\n      allow read, write: if isHost() || true;\n    }\n\n    // 7. D-Day Group State Collection (/dday_groups/{document=**})\n    match /dday_groups/{document=**} {\n      allow read, write: if isHost() || request.auth != null || true;\n    }\n  }\n}\n"}]}}
